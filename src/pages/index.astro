    <footer id="contact" class="bg-white border-t border-slate-200 mt-12 py-8 text-center text-xs text-slate-500">
        <p>&copy; 2026 MeinGesundheitsrechner.de — Alle Rechte vorbehalten.</p>
    </footer>

    <!-- JAVASCRIPT LOGIC & CANVAS DRAWING -->
    <script is:inline>
        function switchTab(tabId) {
            document.querySelectorAll('.calculator-panel').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('aside nav button').forEach(el => {
                el.classList.remove('bg-emerald-50/80', 'text-emerald-700', 'font-semibold');
                el.classList.add('text-slate-600');
            });
            document.getElementById('tab-' + tabId).classList.remove('hidden');
            const activeBtn = document.getElementById('btn-' + tabId);
            if(activeBtn) {
                activeBtn.classList.add('bg-emerald-50/80', 'text-emerald-700', 'font-semibold');
                activeBtn.classList.remove('text-slate-600');
            }
        }

        function drawBmiGauge(bmi) {
            const canvas = document.getElementById('bmiCanvas');
            if(!canvas) return;
            const ctx = canvas.getContext('2d');
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            const cx = 80, cy = 80, r = 60;
            const segments = [
                { start: Math.PI, end: Math.PI + Math.PI*0.25, color: '#3b82f6' },
                { start: Math.PI + Math.PI*0.25, end: Math.PI + Math.PI*0.6, color: '#10b981' },
                { start: Math.PI + Math.PI*0.6, end: Math.PI + Math.PI*0.85, color: '#f59e0b' },
                { start: Math.PI + Math.PI*0.85, end: 2*Math.PI, color: '#ef4444' }
            ];

            segments.forEach(seg => {
                ctx.beginPath();
                ctx.arc(cx, cy, r, seg.start, seg.end);
                ctx.lineWidth = 12;
                ctx.strokeStyle = seg.color;
                ctx.stroke();
            });

            let normalized = (Math.max(10, Math.min(40, bmi)) - 10) / 30;
            let angle = Math.PI + normalized * Math.PI;

            ctx.beginPath();
            ctx.moveTo(cx, cy);
            let nx = cx + (r - 8) * Math.cos(angle);
            let ny = cy + (r - 8) * Math.sin(angle);
            ctx.lineTo(nx, ny);
            ctx.lineWidth = 3;
            ctx.strokeStyle = '#0f172a';
            ctx.stroke();

            ctx.beginPath();
            ctx.arc(cx, cy, 4, 0, 2*Math.PI);
            ctx.fillStyle = '#0f172a';
            ctx.fill();
        }

        function calculateBMI() {
            const hCm = parseFloat(document.getElementById('bmi-height').value);
            const wKg = parseFloat(document.getElementById('bmi-weight').value);
            const hM = hCm / 100;
            const bmi = wKg / (hM * hM);

            let category = "Normalgewicht";
            let desc = "Sie befinden sich im optimalen Normalgewichtsbereich!";
            if (bmi < 18.5) { category = "Untergewicht"; desc = "Sie liegen unter dem optimalen Gewichtsbereich."; }
            else if (bmi >= 25 && bmi < 30) { category = "Übergewicht"; desc = "Sie befinden sich leicht über dem gesunden Bereich."; }
            else if (bmi >= 30) { category = "Adipositas (Fettleibigkeit)"; desc = "Ihr BMI liegt im adipösen Bereich."; }

            document.getElementById('bmi-output').innerText = `BMI = ${bmi.toFixed(1)} kg/m² — ${category}`;
            document.getElementById('bmi-desc').innerText = desc;

            const lowWeight = (18.5 * hM * hM).toFixed(1);
            const highWeight = (24.9 * hM * hM).toFixed(1);
            document.getElementById('bmi-healthy-range').innerText = `${lowWeight} kg – ${highWeight} kg`;

            document.getElementById('bmi-prime').innerText = (bmi / 25).toFixed(2);
            document.getElementById('bmi-ponderal').innerText = (wKg / (Math.pow(hM, 3))).toFixed(1) + ' kg/m³';

            drawBmiGauge(bmi);
        }

        function calculateCalorie() {
            const w = parseFloat(document.getElementById('cal-weight').value);
            const h = parseFloat(document.getElementById('cal-height').value);
            const a = parseFloat(document.getElementById('cal-age').value);
            const cals = Math.round(((10 * w) + (6.25 * h) - (5 * a) + 5) * 1.375);
            document.getElementById('cal-output').innerText = cals.toLocaleString() + ' kcal / Tag';
        }

        function calculateBodyFat() {
            const h = parseFloat(document.getElementById('bf-height').value);
            const n = parseFloat(document.getElementById('bf-neck').value);
            const w = parseFloat(document.getElementById('bf-waist').value);
            const bf = 495 / (1.0324 - 0.19077 * Math.log10(w - n) + 0.15456 * Math.log10(h)) - 450;
            document.getElementById('bf-output').innerText = Math.max(5, bf).toFixed(1) + '% Körperfett';
        }

        function calculateBMR() {
            const g = document.getElementById('bmr-gender').value;
            const a = parseFloat(document.getElementById('bmr-age').value);
            const h = parseFloat(document.getElementById('bmr-height').value);
            const w = parseFloat(document.getElementById('bmr-weight').value);
            let bmr = (10 * w) + (6.25 * h) - (5 * a) + (g === 'male' ? 5 : -161);
            document.getElementById('bmr-output').innerText = `Grundumsatz = ${Math.round(bmr).toLocaleString()} kcal / Tag`;
        }

        function calculateIdeal() {
            const h = parseFloat(document.getElementById('ideal-height').value);
            const g = document.getElementById('ideal-gender').value;
            const ideal = g === 'male' ? (h - 100) * 0.9 : (h - 100) * 0.85;
            document.getElementById('ideal-output').innerText = `Idealgewicht = ${ideal.toFixed(1)} kg`;
        }

        function calculatePace() {
            const d = parseFloat(document.getElementById('pace-dist').value);
            const t = parseFloat(document.getElementById('pace-time').value);
            const paceMin = Math.floor(t / d);
            const paceSec = Math.round(((t / d) - paceMin) * 60);
            document.getElementById('pace-output').innerText = `Pace = ${paceMin}:${paceSec < 10 ? '0' : ''}${paceSec} min/km`;
        }

        function calculatePregnancy() {
            const lmpInput = document.getElementById('preg-lmp').value;
            if(!lmpInput) { document.getElementById('preg-output').innerText = 'Bitte wählen Sie ein Datum aus.'; return; }
            const lmp = new Date(lmpInput);
            const today = new Date();
            const diffDays = Math.floor((today - lmp) / (1000 * 60 * 60 * 24));
            const weeks = Math.floor(diffDays / 7);
            const days = diffDays % 7;
            document.getElementById('preg-output').innerText = `Schwangerschaftswoche: ${weeks}. Woche und ${days} Tage`;
        }

        function calculateConception() {
            const dueInput = document.getElementById('conc-duedate').value;
            if(!dueInput) { document.getElementById('conc-output').innerText = 'Bitte wählen Sie einen Geburtstermin aus.'; return; }
            const due = new Date(dueInput);
            due.setDate(due.getDate() - 266);
            document.getElementById('conc-output').innerText = `Empfängnisdatum: ${due.toLocaleDateString('de-DE')}`;
        }

        function calculateDueDate() {
            const lmpInput = document.getElementById('due-lmp').value;
            if(!lmpInput) { document.getElementById('due-output').innerText = 'Bitte wählen Sie ein Datum aus.'; return; }
            const lmp = new Date(lmpInput);
            lmp.setDate(lmp.getDate() + 280);
            document.getElementById('due-output').innerText = `Geburtstermin: ${lmp.toLocaleDateString('de-DE')}`;
        }

        function calculateTDEE() {
            const w = parseFloat(document.getElementById('tdee-weight').value);
            const m = parseFloat(document.getElementById('tdee-activity').value);
            document.getElementById('tdee-output').innerText = `TDEE = ${Math.round((10 * w + 625 - 125) * m).toLocaleString()} kcal`;
        }

        function calculateDeficit() {
            const tdee = parseFloat(document.getElementById('def-tdee').value);
            const adj = parseInt(document.getElementById('def-goal').value);
            document.getElementById('def-output').innerText = `Ziel = ${(tdee + adj).toLocaleString()} kcal`;
        }

        function calculateMacros() {
            const cals = parseFloat(document.getElementById('mac-cals').value);
            const w = parseFloat(document.getElementById('mac-weight').value);
            const p = Math.round(w * 2.0);
            const f = Math.round((cals * 0.25) / 9);
            const cb = Math.max(0, Math.round((cals - (p * 4 + f * 9)) / 4));
            document.getElementById('macro-protein').innerText = p + ' g';
            document.getElementById('macro-fat').innerText = f + ' g';
            document.getElementById('macro-carbs').innerText = cb + ' g';
        }

        function calculateORM() {
            const w = parseFloat(document.getElementById('orm-weight').value);
            const r = parseFloat(document.getElementById('orm-reps').value);
            const orm = r === 1 ? w : w * (1 + r / 30);
            document.getElementById('orm-output').innerText = `1RM = ${Math.round(orm)} kg`;
        }

        window.onload = () => { calculateBMI(); };
    </script>
  </div>
</Layout>