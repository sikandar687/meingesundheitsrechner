---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('ratgeber');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title}>
  <main class="max-w-3xl mx-auto px-4 py-12 prose lg:prose-lg text-gray-800">
    <h1>{post.data.title}</h1>
    {post.data.description && <p class="text-lg text-gray-600 font-medium mb-8">{post.data.description}</p>}
    <hr class="my-6" />
    <Content />
  </main>
</Layout>