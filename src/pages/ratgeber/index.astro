---
// src/pages/ratgeber/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allArticles = await getCollection('ratgeber');
---

<Layout title="Ratgeber — MeinGesundheitsrechner.de" description="Entdecken Sie unsere fundierten Artikel zu Gesundheit, Fitness und Ernährung.">
  <div class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col justify-between font-sans">

    <!-- HEADER -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <a href="/" class="flex items-center p-1.5 bg-emerald-50 border border-emerald-100 rounded-lg shadow-sm hover:bg-emerald-100 transition">
                    <img src="/favicon.svg" alt="MeinGesundheitsrechner.de Logo" class="h-6 w-6 object-contain text-emerald-600" />
                </a>
                <span class="font-bold text-base tracking-tight text-slate-900">MeinGesundheitsrechner<span class="text-slate-400">.de</span></span>
            </div>
            <nav class="hidden md:flex space-x-6 text-sm font-medium text-slate-600">
                <a href="/" class="hover:text-emerald-600 transition">Rechner</a>
                <a href="/ratgeber" class="text-emerald-600 font-semibold transition">Ratgeber</a>
            </nav>
        </div>
    </header>

    <!-- MAIN CONTENT LISTING -->
    <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full flex-grow space-y-8">
        <div class="border-b border-slate-100 pb-6">
            <span class="text-xs font-bold text-emerald-600 uppercase tracking-widest">Übersicht</span>
            <h1 class="text-3xl font-extrabold text-slate-900 mt-1">Alle Ratgeber Artikel</h1>
            <p class="text-sm text-slate-500 mt-2">Wissenschaftlich fundierte Artikel rund um Fitness, Training und Ernährung.</p>
        </div>

        <div class="grid grid-cols-1 gap-6">
            {allArticles.map((article) => (
                <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm space-y-3 flex flex-col justify-between">
                    <div class="space-y-2">
                        <span class="text-[10px] font-bold bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-full uppercase tracking-wider">Artikel</span>
                        <h2 class="text-xl font-bold text-slate-900">
                            <a href={`/ratgeber/${article.slug}`} class="hover:text-emerald-600 transition">
                                {article.data.title}
                            </a>
                        </h2>
                        <p class="text-sm text-slate-600 leading-relaxed">
                            {article.data.description}
                        </p>
                    </div>
                    <div>
                        <a href={`/ratgeber/${article.slug}`} class="inline-block text-sm font-semibold text-emerald-600 hover:text-emerald-700 transition pt-2">
                            Vollständigen Artikel lesen &rarr;
                        </a>
                    </div>
                </div>
            ))}
        </div>
    </main>

    <!-- FOOTER -->
    <footer class="bg-white border-t border-slate-200 mt-12 py-8 text-center text-xs text-slate-500">
        <p>&copy; 2026 MeinGesundheitsrechner.de — Alle Rechte vorbehalten.</p>
    </footer>

  </div>
</Layout>